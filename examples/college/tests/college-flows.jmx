<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="BlazeMeter Tech College - Apply &amp; Register Flows">
      <stringProp name="TestPlan.comments">Traffic-mix load test for the college example (examples/college). The pages are a client-side JS app: form validation, the application wizard, sign-in, course search and the registration cart all run in the browser against sessionStorage. There is no backend API, so the HTTP conversation a server actually sees is a sequence of static GETs (HTML + styles.css + site.js + data/courses.js). The samplers below reflect exactly that; the in-browser work is represented by JSR223 samplers so the think time and step boundaries still show up in the report.

TRAFFIC SPLIT: two Throughput Controllers in Percent Executions mode - 60% Flow A (Apply Now), 40% Flow B (Existing student registers). The two controllers are evaluated independently per iteration, so each converges on its own share over the run rather than strictly alternating. Because they sum to 100 the overall mix averages one flow per iteration. Percentages are literal floats (JMeter cannot bind a variable to that field), so edit them in the GUI or in this XML to rebalance.

DEFAULT TARGET is the deployed example on GitHub Pages at 1 virtual user - a smoke-level profile that verifies the flows and the traffic split without meaningful load. Point it at a local copy before raising concurrency: python3 -m http.server 8000 from the repo root, then -Jprotocol=http -Jhost=localhost -Jport=8000 -Jbase=/examples/college. Other overrides: -Jusers= -Jramp= -Jduration= -Jloops= -Jthink_ms=.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(protocol,https)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,benjithompson.github.io)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(port,443)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BASE" elementType="Argument">
            <stringProp name="Argument.name">BASE</stringProp>
            <stringProp name="Argument.value">${__P(base,/PerfectoExamplePages/examples/college)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SLA_PAGE_MS" elementType="Argument">
            <stringProp name="Argument.name">SLA_PAGE_MS</stringProp>
            <stringProp name="Argument.value">${__P(sla_page_ms,3000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SLA_ASSET_MS" elementType="Argument">
            <stringProp name="Argument.name">SLA_ASSET_MS</stringProp>
            <stringProp name="Argument.value">${__P(sla_asset_ms,2000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THINK_CONSTANT_MS" elementType="Argument">
            <stringProp name="Argument.name">THINK_CONSTANT_MS</stringProp>
            <stringProp name="Argument.value">${__P(think_ms,600)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THINK_RANGE_MS" elementType="Argument">
            <stringProp name="Argument.name">THINK_RANGE_MS</stringProp>
            <stringProp name="Argument.value">${__P(think_range_ms,1200)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="FORM_THINK_MS" elementType="Argument">
            <stringProp name="Argument.name">FORM_THINK_MS</stringProp>
            <stringProp name="Argument.value">${__P(form_think_ms,4000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="FORM_THINK_RANGE_MS" elementType="Argument">
            <stringProp name="Argument.name">FORM_THINK_RANGE_MS</stringProp>
            <stringProp name="Argument.value">${__P(form_think_range_ms,6000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DEMO_USERNAME" elementType="Argument">
            <stringProp name="Argument.name">DEMO_USERNAME</stringProp>
            <stringProp name="Argument.value">jdoe</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DEMO_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">DEMO_PASSWORD</stringProp>
            <stringProp name="Argument.value">Test1234!</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
