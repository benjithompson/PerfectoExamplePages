            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="B05 Sign In (client-side)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Sign-in is validated in the browser against a hard-coded demo user and the
// session is written to sessionStorage - no credentials leave the page and no
// auth endpoint is called. This sampler marks the step and carries the demo
// identity forward for logging.

vars.put(&apos;sis_username&apos;, vars.get(&apos;DEMO_USERNAME&apos;))
vars.put(&apos;sis_student_id&apos;, &apos;S00123456&apos;)
log.info(&quot;Flow B signed in as ${vars.get(&apos;sis_username&apos;)} (${vars.get(&apos;sis_student_id&apos;)})&quot;)
              </stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
