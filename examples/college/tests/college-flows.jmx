            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="A06 Complete Application Wizard (client-side)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// The five wizard steps (contact form, personal info, program &amp; term,
// education history, review/certify) are handled entirely in the browser
// and produce no HTTP traffic. This sampler stands in for that work so the
// step still appears in the report with realistic data-entry time.

def rnd = new Random()
def firstNames = [&apos;Alex&apos;,&apos;Jordan&apos;,&apos;Sam&apos;,&apos;Riley&apos;,&apos;Casey&apos;,&apos;Morgan&apos;,&apos;Avery&apos;,&apos;Quinn&apos;]
def lastNames  = [&apos;Rivera&apos;,&apos;Chen&apos;,&apos;Okafor&apos;,&apos;Novak&apos;,&apos;Delgado&apos;,&apos;Haddad&apos;,&apos;Lindqvist&apos;,&apos;Osei&apos;]
def campuses   = [&apos;Ashford&apos;,&apos;Brookdale&apos;,&apos;Clearview&apos;,&apos;Northgate&apos;]
def programs   = [&apos;A.A.S. Computer Information Systems&apos;,&apos;A.A.S. Nursing&apos;,
                  &apos;A.A.S. Business Administration&apos;,&apos;B.A.S. Cybersecurity&apos;]

def first = firstNames[rnd.nextInt(firstNames.size())]
def last  = lastNames[rnd.nextInt(lastNames.size())]

vars.put(&apos;applicant_first&apos;, first)
vars.put(&apos;applicant_last&apos;, last)
vars.put(&apos;applicant_email&apos;, &quot;${first.toLowerCase()}.${last.toLowerCase()}${rnd.nextInt(9999)}@example.com&quot;)
vars.put(&apos;applicant_campus&apos;, campuses[rnd.nextInt(campuses.size())])
vars.put(&apos;applicant_program&apos;, programs[rnd.nextInt(programs.size())])

// Application number is generated client-side as APP-2026-nnnnnn.
vars.put(&apos;application_id&apos;, &apos;APP-2026-&apos; + (100000 + rnd.nextInt(899999)))

log.info(&quot;Flow A application completed: ${vars.get(&apos;application_id&apos;)} &quot; +
         &quot;${first} ${last} / ${vars.get(&apos;applicant_campus&apos;)} / ${vars.get(&apos;applicant_program&apos;)}&quot;)
              </stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
            </JSR223Sampler>
