            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="B09 Search - Add to Cart - Submit (client-side)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Term selection, course search, the Pending cart and Submit all run against
// the catalog already downloaded in data/courses.js. No further HTTP traffic
// is generated. This sampler represents that browsing/registration time and
// records what a virtual student would have registered for.

def rnd = new Random()
def subjects = [&apos;CIS&apos;,&apos;ENG&apos;,&apos;MAT&apos;,&apos;BIO&apos;,&apos;PSY&apos;,&apos;ACC&apos;,&apos;BUS&apos;,&apos;CRJ&apos;,&apos;NUR&apos;,&apos;CHM&apos;]
def sections = [&apos;10241&apos;,&apos;10310&apos;,&apos;10455&apos;,&apos;10501&apos;,&apos;10611&apos;,&apos;10715&apos;,&apos;10801&apos;,&apos;10905&apos;]

def picked = (1..(2 + rnd.nextInt(3))).collect { sections[rnd.nextInt(sections.size())] }.unique()

vars.put(&apos;reg_term&apos;, &apos;FA26&apos;)
vars.put(&apos;reg_subject&apos;, subjects[rnd.nextInt(subjects.size())])
vars.put(&apos;reg_crns&apos;, picked.join(&apos;,&apos;))
vars.put(&apos;reg_count&apos;, String.valueOf(picked.size()))

log.info(&quot;Flow B registered ${picked.size()} section(s) for FA26: ${picked.join(&apos;, &apos;)}&quot;)
              </stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
            </JSR223Sampler>
            <hashTree>
              <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Course Selection Time" enabled="true">
                <stringProp name="ConstantTimer.delay">${FORM_THINK_MS}</stringProp>
                <stringProp name="RandomTimer.range">${FORM_THINK_RANGE_MS}</stringProp>
              </UniformRandomTimer>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>
