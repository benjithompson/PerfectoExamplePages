{
  "name": "college-apply-flow-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright test for the BlazeMeter Tech College Apply Now flow. Self-contained so it can be zipped and uploaded to BlazeMeter or run standalone.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "install:browsers": "playwright install --with-deps",
    "taurus": "bzt blazemeter.yml"
  },
  "keywords": [
    "playwright",
    "blazemeter",
    "taurus",
    "e2e"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  }
}
