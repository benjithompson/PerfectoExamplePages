<?xml version="1.0" encoding="UTF-8"?>
<!--
  OAuth 2.0 PKCE Authorization Flow – JMeter Test Plan
  =====================================================
  Models a full PKCE flow as a real web server would serve it:

    01  GET  Home page
    02       [JSR223] Generate code_verifier, code_challenge (SHA-256), state
    03  GET  Authorization endpoint  (?response_type=code&code_challenge=…)
    04  POST Login credentials       → 302 redirect to MFA page
    05  GET  MFA page
    06  POST 2FA code (TOTP)         → 302 redirect to callback with ?code=
    07       [JSR223] Verify state matches original (CSRF check)
    08  GET  Callback URL            (?code=…&state=…)
    09  POST Token endpoint          → JSON {access_token, token_type, expires_in}
    10  GET  Protected resource      (Authorization: Bearer <token>)

  Runtime overrides (pass with -J on CLI):
    -Jusers=10        concurrent virtual users  (default 1)
    -Jramp=30         ramp-up seconds           (default 5)
    -Jduration=120    test duration seconds      (default 60)
    -Jloops=-1        iterations per thread (-1 = use duration) (default -1)
    -Jhost=localhost
    -Jport=7432
    -Jprotocol=http

  Run headless:
    jmeter -n -t oauth2-pkce-flow.jmx -l results/run.jtl -e -o results/report/
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>

    <!-- ════════════════════════════════════════════════════════════
         TEST PLAN
         ════════════════════════════════════════════════════════════ -->
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan"
              testname="OAuth 2.0 PKCE Authorization Flow" enabled="true">
      <stringProp name="TestPlan.comments">Full PKCE auth flow: home → authorize → login → 2FA → callback → token exchange → protected resource.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments"
                   guiclass="ArgumentsPanel" testclass="Arguments"
                   testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">

          <!-- ── Server ── -->
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(port,7432)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>

          <!-- ── OAuth endpoints (relative paths) ── -->
          <elementProp name="PATH_HOME" elementType="Argument">
            <stringProp name="Argument.name">PATH_HOME</stringProp>
            <stringProp name="Argument.value">/examples/oauth2-pkce/index.html</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PATH_AUTHORIZE" elementType="Argument">
            <stringProp name="Argument.name">PATH_AUTHORIZE</stringProp>
            <stringProp name="Argument.value">/examples/oauth2-pkce/auth-server.html</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PATH_LOGIN" elementType="Argument">
            <stringProp name="Argument.name">PATH_LOGIN</stringProp>
            <stringProp name="Argument.value">/examples/oauth2-pkce/login</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PATH_MFA" elementType="Argument">
            <stringProp name="Argument.name">PATH_MFA</stringProp>
            <stringProp name="Argument.value">/examples/oauth2-pkce/mfa</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PATH_CALLBACK" elementType="Argument">
            <stringProp name="Argument.name">PATH_CALLBACK</stringProp>
            <stringProp name="Argument.value">/examples/oauth2-pkce/index.html</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PATH_TOKEN" elementType="Argument">
            <stringProp name="Argument.name">PATH_TOKEN</stringProp>
            <stringProp name="Argument.value">/examples/oauth2-pkce/token</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PATH_PROTECTED" elementType="Argument">
            <stringProp name="Argument.name">PATH_PROTECTED</stringProp>
            <stringProp name="Argument.value">/examples/oauth2-pkce/api/me</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>

          <!-- ── OAuth client config ── -->
          <elementProp name="CLIENT_ID" elementType="Argument">
            <stringProp name="Argument.name">CLIENT_ID</stringProp>
            <stringProp name="Argument.value">pkce-demo-client</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SCOPE" elementType="Argument">
            <stringProp name="Argument.name">SCOPE</stringProp>
            <stringProp name="Argument.value">openid profile</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="REDIRECT_URI" elementType="Argument">
            <stringProp name="Argument.name">REDIRECT_URI</stringProp>
            <stringProp name="Argument.value">${PROTOCOL}://${HOST}:${PORT}${PATH_CALLBACK}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>

          <!-- ── SLA ── -->
          <elementProp name="SLA_PAGE_MS" elementType="Argument">
            <stringProp name="Argument.name">SLA_PAGE_MS</stringProp>
            <stringProp name="Argument.value">3000</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SLA_API_MS" elementType="Argument">
            <stringProp name="Argument.name">SLA_API_MS</stringProp>
            <stringProp name="Argument.value">1000</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>

          <!-- ── Think time ── -->
          <elementProp name="THINK_CONSTANT_MS" elementType="Argument">
            <stringProp name="Argument.name">THINK_CONSTANT_MS</stringProp>
            <stringProp name="Argument.value">500</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THINK_RANGE_MS" elementType="Argument">
            <stringProp name="Argument.name">THINK_RANGE_MS</stringProp>
            <stringProp name="Argument.value">1000</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>

        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ════════════════════════════════════════════════════════════
           SHARED CONFIG (applies to all thread groups)
           ════════════════════════════════════════════════════════════ -->

      <!-- HTTP Request Defaults: host, port, protocol, timeouts -->
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement"
                         testname="HTTP Request Defaults" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments"
                     guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
        <stringProp name="HTTPSampler.port">${PORT}</stringProp>
        <stringProp name="HTTPSampler.protocol">${PROTOCOL}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.path"></stringProp>
        <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
        <boolProp name="HTTPSampler.image_parser">false</boolProp>
        <boolProp name="HTTPSampler.concurrentDwn">false</boolProp>
      </ConfigTestElement>
      <hashTree/>

      <!-- Cookie Manager: isolate cookies per iteration -->
      <CookieManager guiclass="CookiePanel" testclass="CookieManager"
                     testname="HTTP Cookie Manager" enabled="true">
        <collectionProp name="CookieManager.cookies"/>
        <boolProp name="CookieManager.clearEachIteration">true</boolProp>
        <boolProp name="CookieManager.controlledByThreadGroup">false</boolProp>
      </CookieManager>
      <hashTree/>

      <!-- Cache Manager: realistic browser caching behaviour -->
      <CacheManager guiclass="CacheManagerGui" testclass="CacheManager"
                    testname="HTTP Cache Manager" enabled="true">
        <boolProp name="clearEachIteration">true</boolProp>
        <boolProp name="useExpires">true</boolProp>
        <intProp name="maxSize">5000</intProp>
      </CacheManager>
      <hashTree/>

      <!-- CSV Data Set: parameterised credentials -->
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet"
                  testname="User Credentials" enabled="true">
        <stringProp name="filename">credentials.csv</stringProp>
        <stringProp name="fileEncoding">UTF-8</stringProp>
        <stringProp name="variableNames">username,password,totp_code</stringProp>
        <boolProp name="ignoreFirstLine">true</boolProp>
        <stringProp name="delimiter">,</stringProp>
        <boolProp name="quotedData">false</boolProp>
        <boolProp name="recycle">true</boolProp>
        <boolProp name="stopThread">false</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
      </CSVDataSet>
      <hashTree/>

      <!-- ════════════════════════════════════════════════════════════
           MAIN THREAD GROUP
           ════════════════════════════════════════════════════════════ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup"
                   testname="OAuth PKCE Users" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController"
                     guiclass="LoopControlPanel" testclass="LoopController"
                     testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(loops,-1)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(users,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,5)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,60)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
      </ThreadGroup>
      <hashTree>

        <!-- Think time between requests (500–1500 ms) -->
        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer"
                            testname="Think Time" enabled="true">
          <stringProp name="ConstantTimer.delay">${THINK_CONSTANT_MS}</stringProp>
          <stringProp name="RandomTimer.range">${THINK_RANGE_MS}</stringProp>
        </UniformRandomTimer>
        <hashTree/>

        <!-- ──────────────────────────────────────────────────────────
             01  GET Home Page
             ────────────────────────────────────────────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="01 GET Home Page" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"
                       guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.path">${PATH_HOME}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                             testname="Assert 200 OK" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                             testname="SLA: Page &lt; ${SLA_PAGE_MS}ms" enabled="true">
            <stringProp name="DurationAssertion.duration">${SLA_PAGE_MS}</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- ──────────────────────────────────────────────────────────
             02  Generate PKCE Parameters (Groovy / JSR223)
             Produces: code_verifier, code_challenge, state
             ────────────────────────────────────────────────────────── -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler"
                       testname="02 Generate PKCE Parameters" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.security.MessageDigest
import java.security.SecureRandom
import java.util.Base64

def random = new SecureRandom()

// ── code_verifier: 32 random bytes → base64url (no padding) ──────────────
// RFC 7636 §4.1: verifier must be 43–128 unreserved ASCII chars.
// 32 bytes → 43 base64url chars, satisfying the minimum.
def verifierBytes = new byte[32]
random.nextBytes(verifierBytes)
def codeVerifier = Base64.getUrlEncoder().withoutPadding().encodeToString(verifierBytes)

// ── code_challenge: BASE64URL(SHA-256(ASCII(code_verifier))) ─────────────
// RFC 7636 §4.2: S256 method.
def digest = MessageDigest.getInstance("SHA-256")
def challengeBytes = digest.digest(codeVerifier.getBytes("US-ASCII"))
def codeChallenge = Base64.getUrlEncoder().withoutPadding().encodeToString(challengeBytes)

// ── state: 16 random bytes → base64url (CSRF protection) ─────────────────
def stateBytes = new byte[16]
random.nextBytes(stateBytes)
def state = Base64.getUrlEncoder().withoutPadding().encodeToString(stateBytes)

// Store in thread-local JMeter variables
vars.put("code_verifier",  codeVerifier)
vars.put("code_challenge", codeChallenge)
vars.put("pkce_state",     state)
// Clear any previous correlation variables
vars.put("auth_code",    "")
vars.put("return_state", "")
vars.put("access_token", "")
vars.put("csrf_token",   "")

log.info("PKCE generated — verifier_len=" + codeVerifier.length()
         + " challenge_prefix=" + codeChallenge.take(12) + "..."
         + " state_prefix=" + state.take(8) + "...")

SampleResult.setResponseData(
  "code_verifier="  + codeVerifier  + "\n" +
  "code_challenge=" + codeChallenge + "\n" +
  "state="          + state,
  "UTF-8")
SampleResult.setResponseCodeOK()
SampleResult.setSuccessful(true)
          </stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- ──────────────────────────────────────────────────────────
             03  GET Authorization Endpoint
             Sends the PKCE code_challenge to the auth server.
             A real server returns a login form containing a CSRF token.
             ────────────────────────────────────────────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="03 GET Authorization Endpoint" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"
                       guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="response_type" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">response_type</stringProp>
                <stringProp name="Argument.value">code</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="client_id" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">client_id</stringProp>
                <stringProp name="Argument.value">${CLIENT_ID}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="redirect_uri" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">redirect_uri</stringProp>
                <stringProp name="Argument.value">${REDIRECT_URI}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="code_challenge" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">code_challenge</stringProp>
                <stringProp name="Argument.value">${code_challenge}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="code_challenge_method" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">code_challenge_method</stringProp>
                <stringProp name="Argument.value">S256</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="state" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">state</stringProp>
                <stringProp name="Argument.value">${pkce_state}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="scope" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">scope</stringProp>
                <stringProp name="Argument.value">${SCOPE}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">${PATH_AUTHORIZE}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                             testname="Assert 200 OK" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <!-- Correlate: CSRF token hidden in login form
               Adapt the regex to match the actual field name and format your
               server uses (e.g. _csrf, authenticity_token, __RequestVerificationToken). -->
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                          testname="Extract CSRF Token" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">csrf_token</stringProp>
            <stringProp name="RegexExtractor.regex">(?:name="_csrf"|name="csrf_token"|name="authenticity_token")[^>]*value="([^"]+)"</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NO_CSRF</stringProp>
            <stringProp name="RegexExtractor.match_no">1</stringProp>
            <stringProp name="RegexExtractor.scope">main</stringProp>
          </RegexExtractor>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                             testname="SLA: Page &lt; ${SLA_PAGE_MS}ms" enabled="true">
            <stringProp name="DurationAssertion.duration">${SLA_PAGE_MS}</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- ──────────────────────────────────────────────────────────
             04  POST Login Credentials
             Follow Redirects = false so we can capture the redirect
             to the MFA page or (if no MFA) directly to the callback.
             ────────────────────────────────────────────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="04 POST Login Credentials" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"
                       guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="username" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">username</stringProp>
                <stringProp name="Argument.value">${username}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="password" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">password</stringProp>
                <stringProp name="Argument.value">${password}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <!-- Include CSRF token if present -->
              <elementProp name="_csrf" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">_csrf</stringProp>
                <stringProp name="Argument.value">${csrf_token}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">${PATH_LOGIN}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- Expect a redirect after successful login -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                             testname="Assert 302 Redirect to MFA" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">302</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <!-- Correlate: MFA session or nonce from redirect Location header -->
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                          testname="Extract MFA Session Token" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            <stringProp name="RegexExtractor.refname">mfa_session</stringProp>
            <stringProp name="RegexExtractor.regex">Location:.*[?&amp;]mfa_session=([^&amp;\r\n]+)</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NO_MFA_SESSION</stringProp>
            <stringProp name="RegexExtractor.match_no">1</stringProp>
            <stringProp name="RegexExtractor.scope">main</stringProp>
          </RegexExtractor>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                             testname="SLA: Login POST &lt; ${SLA_API_MS}ms" enabled="true">
            <stringProp name="DurationAssertion.duration">${SLA_API_MS}</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- ──────────────────────────────────────────────────────────
             05  GET MFA Page
             ────────────────────────────────────────────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="05 GET MFA Page" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"
                       guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="mfa_session" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">mfa_session</stringProp>
                <stringProp name="Argument.value">${mfa_session}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">${PATH_MFA}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                             testname="Assert 200 OK" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <!-- Correlate: CSRF token on the MFA form (may differ from login form token) -->
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                          testname="Extract MFA CSRF Token" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">mfa_csrf_token</stringProp>
            <stringProp name="RegexExtractor.regex">(?:name="_csrf"|name="csrf_token"|name="mfa_token")[^>]*value="([^"]+)"</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NO_MFA_CSRF</stringProp>
            <stringProp name="RegexExtractor.match_no">1</stringProp>
            <stringProp name="RegexExtractor.scope">main</stringProp>
          </RegexExtractor>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                             testname="SLA: Page &lt; ${SLA_PAGE_MS}ms" enabled="true">
            <stringProp name="DurationAssertion.duration">${SLA_PAGE_MS}</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- ──────────────────────────────────────────────────────────
             06  POST 2FA Code
             Follow Redirects = false to capture the Location header
             containing the authorization code and state.
             ────────────────────────────────────────────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="06 POST 2FA Code" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"
                       guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="totp_code" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">totp_code</stringProp>
                <stringProp name="Argument.value">${totp_code}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="mfa_session" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">mfa_session</stringProp>
                <stringProp name="Argument.value">${mfa_session}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="_csrf" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">_csrf</stringProp>
                <stringProp name="Argument.value">${mfa_csrf_token}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">${PATH_MFA}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- After successful 2FA the server redirects to the redirect_uri with ?code=&state= -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                             testname="Assert 302 Redirect to Callback" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">302</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <!-- Assert Location header contains the expected redirect_uri -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                             testname="Assert Location Contains redirect_uri" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">${PATH_CALLBACK}</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_headers</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <!-- Correlate: authorization code from Location header -->
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                          testname="Extract Authorization Code" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            <stringProp name="RegexExtractor.refname">auth_code</stringProp>
            <stringProp name="RegexExtractor.regex">Location:.*[?&amp;]code=([^&amp;\r\n]+)</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">CODE_NOT_FOUND</stringProp>
            <stringProp name="RegexExtractor.match_no">1</stringProp>
            <stringProp name="RegexExtractor.scope">main</stringProp>
          </RegexExtractor>
          <hashTree/>
          <!-- Correlate: state returned in the callback URL (must match pkce_state) -->
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                          testname="Extract Returned State" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            <stringProp name="RegexExtractor.refname">return_state</stringProp>
            <stringProp name="RegexExtractor.regex">Location:.*[?&amp;]state=([^&amp;\r\n]+)</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">STATE_NOT_FOUND</stringProp>
            <stringProp name="RegexExtractor.match_no">1</stringProp>
            <stringProp name="RegexExtractor.scope">main</stringProp>
          </RegexExtractor>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                             testname="SLA: MFA POST &lt; ${SLA_API_MS}ms" enabled="true">
            <stringProp name="DurationAssertion.duration">${SLA_API_MS}</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- ──────────────────────────────────────────────────────────
             07  Verify State (CSRF protection check)
             The returned state must match the one we generated.
             Marks the sample failed if there is a mismatch, which
             would indicate a replay or session-fixation attack in a
             real test, or a correlation bug here.
             ────────────────────────────────────────────────────────── -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler"
                       testname="07 Verify State (CSRF Check)" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
def sent     = vars.get("pkce_state")   ?: ""
def received = vars.get("return_state") ?: ""
def code     = vars.get("auth_code")    ?: ""

if (!code || code == "CODE_NOT_FOUND") {
  def msg = "Authorization code not found in callback redirect — check sampler 06"
  log.error(msg)
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode("400")
  SampleResult.setResponseMessage(msg)
  return
}

if (sent != received) {
  def msg = "State mismatch — sent=[" + sent + "] received=[" + received + "]. " +
            "Possible CSRF or correlation failure."
  log.error(msg)
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode("400")
  SampleResult.setResponseMessage(msg)
  return
}

log.info("State verified OK. auth_code prefix=" + code.take(8) + "...")
SampleResult.setResponseData("state_ok=true\nauth_code=" + code, "UTF-8")
SampleResult.setResponseCodeOK()
SampleResult.setSuccessful(true)
          </stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- ──────────────────────────────────────────────────────────
             08  GET Callback (redirect_uri?code=…&state=…)
             The client app receives the authorization code.
             ────────────────────────────────────────────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="08 GET Callback" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"
                       guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="code" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">code</stringProp>
                <stringProp name="Argument.value">${auth_code}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="state" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">state</stringProp>
                <stringProp name="Argument.value">${pkce_state}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">${PATH_CALLBACK}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                             testname="Assert 200 OK" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                             testname="SLA: Page &lt; ${SLA_PAGE_MS}ms" enabled="true">
            <stringProp name="DurationAssertion.duration">${SLA_PAGE_MS}</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- ──────────────────────────────────────────────────────────
             09  POST Token Exchange
             RFC 6749 §4.1.3 / RFC 7636 §4.5
             Sends code + code_verifier to the token endpoint.
             The server re-derives the challenge from the verifier and
             compares it to the stored challenge — this is the PKCE
             security enforcement step.
             ────────────────────────────────────────────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="09 POST Token Exchange" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"
                       guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="grant_type" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">grant_type</stringProp>
                <stringProp name="Argument.value">authorization_code</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="code" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">code</stringProp>
                <stringProp name="Argument.value">${auth_code}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="code_verifier" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">code_verifier</stringProp>
                <stringProp name="Argument.value">${code_verifier}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="client_id" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">client_id</stringProp>
                <stringProp name="Argument.value">${CLIENT_ID}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="redirect_uri" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">redirect_uri</stringProp>
                <stringProp name="Argument.value">${REDIRECT_URI}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">${PATH_TOKEN}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <!-- Token endpoint accepts application/x-www-form-urlencoded -->
        </HTTPSamplerProxy>
        <hashTree>
          <!-- Override Content-Type for this request only -->
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                         testname="Content-Type: form-encoded" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/x-www-form-urlencoded</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Accept</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                             testname="Assert 200 OK" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                             testname="Assert access_token present" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">access_token</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <!-- Correlate: access token for use in subsequent requests -->
          <JSONPathExtractor guiclass="JSONPathExtractorGui" testclass="JSONPathExtractor"
                             testname="Extract access_token" enabled="true">
            <stringProp name="JSONPathExtractor.referenceNames">access_token</stringProp>
            <stringProp name="JSONPathExtractor.jsonPathExprs">$.access_token</stringProp>
            <stringProp name="JSONPathExtractor.defaultValues">TOKEN_NOT_FOUND</stringProp>
            <stringProp name="JSONPathExtractor.match_no">0</stringProp>
            <stringProp name="JSONPathExtractor.scope">main</stringProp>
          </JSONPathExtractor>
          <hashTree/>
          <JSONPathExtractor guiclass="JSONPathExtractorGui" testclass="JSONPathExtractor"
                             testname="Extract token_type" enabled="true">
            <stringProp name="JSONPathExtractor.referenceNames">token_type</stringProp>
            <stringProp name="JSONPathExtractor.jsonPathExprs">$.token_type</stringProp>
            <stringProp name="JSONPathExtractor.defaultValues">Bearer</stringProp>
            <stringProp name="JSONPathExtractor.match_no">0</stringProp>
            <stringProp name="JSONPathExtractor.scope">main</stringProp>
          </JSONPathExtractor>
          <hashTree/>
          <JSONPathExtractor guiclass="JSONPathExtractorGui" testclass="JSONPathExtractor"
                             testname="Extract expires_in" enabled="true">
            <stringProp name="JSONPathExtractor.referenceNames">expires_in</stringProp>
            <stringProp name="JSONPathExtractor.jsonPathExprs">$.expires_in</stringProp>
            <stringProp name="JSONPathExtractor.defaultValues">3600</stringProp>
            <stringProp name="JSONPathExtractor.match_no">0</stringProp>
            <stringProp name="JSONPathExtractor.scope">main</stringProp>
          </JSONPathExtractor>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                             testname="SLA: Token POST &lt; ${SLA_API_MS}ms" enabled="true">
            <stringProp name="DurationAssertion.duration">${SLA_API_MS}</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- ──────────────────────────────────────────────────────────
             10  GET Protected Resource
             Uses the Bearer access token obtained in step 09.
             ────────────────────────────────────────────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="10 GET Protected Resource" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"
                       guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.path">${PATH_PROTECTED}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- Bearer token — set per-sampler so it does not bleed into other requests -->
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                         testname="Authorization: Bearer Token" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">${token_type} ${access_token}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Accept</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                             testname="Assert 200 OK" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                             testname="SLA: API &lt; ${SLA_API_MS}ms" enabled="true">
            <stringProp name="DurationAssertion.duration">${SLA_API_MS}</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- ════════════════════════════════════════════════════════════
             LISTENERS
             View Results Tree: disabled by default — enable locally for
             debugging only; never run enabled under load.
             ════════════════════════════════════════════════════════════ -->
        <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector"
                         testname="View Results Tree (DEBUG — disable for load)"
                         enabled="false">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
            <value class="SampleSaveConfiguration">
              <time>true</time>
              <latency>true</latency>
              <timestamp>true</timestamp>
              <success>true</success>
              <label>true</label>
              <code>true</code>
              <message>true</message>
              <threadName>true</threadName>
              <dataType>true</dataType>
              <encoding>false</encoding>
              <assertions>true</assertions>
              <subresults>true</subresults>
              <responseData>true</responseData>
              <samplerData>true</samplerData>
              <xml>false</xml>
              <fieldNames>true</fieldNames>
              <responseHeaders>true</responseHeaders>
              <requestHeaders>true</requestHeaders>
              <responseDataOnError>true</responseDataOnError>
              <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
              <bytes>true</bytes>
              <sentBytes>true</sentBytes>
              <url>true</url>
              <threadCounts>true</threadCounts>
              <idleTime>true</idleTime>
              <connectTime>true</connectTime>
            </value>
          </objProp>
          <stringProp name="filename"></stringProp>
        </ResultCollector>
        <hashTree/>

        <ResultCollector guiclass="SummaryReport" testclass="ResultCollector"
                         testname="Summary Report" enabled="true">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
            <value class="SampleSaveConfiguration">
              <time>true</time>
              <latency>true</latency>
              <timestamp>true</timestamp>
              <success>true</success>
              <label>true</label>
              <code>true</code>
              <message>true</message>
              <threadName>true</threadName>
              <dataType>false</dataType>
              <encoding>false</encoding>
              <assertions>true</assertions>
              <subresults>false</subresults>
              <responseData>false</responseData>
              <samplerData>false</samplerData>
              <xml>false</xml>
              <fieldNames>true</fieldNames>
              <responseHeaders>false</responseHeaders>
              <requestHeaders>false</requestHeaders>
              <responseDataOnError>false</responseDataOnError>
              <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
              <bytes>true</bytes>
              <sentBytes>true</sentBytes>
              <url>true</url>
              <threadCounts>true</threadCounts>
              <idleTime>true</idleTime>
              <connectTime>true</connectTime>
            </value>
          </objProp>
          <stringProp name="filename">results/summary.jtl</stringProp>
        </ResultCollector>
        <hashTree/>

        <ResultCollector guiclass="StatVisualizer" testclass="ResultCollector"
                         testname="Aggregate Report" enabled="true">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
            <value class="SampleSaveConfiguration">
              <time>true</time>
              <latency>true</latency>
              <timestamp>true</timestamp>
              <success>true</success>
              <label>true</label>
              <code>true</code>
              <message>true</message>
              <threadName>false</threadName>
              <dataType>false</dataType>
              <encoding>false</encoding>
              <assertions>true</assertions>
              <subresults>false</subresults>
              <responseData>false</responseData>
              <samplerData>false</samplerData>
              <xml>false</xml>
              <fieldNames>true</fieldNames>
              <responseHeaders>false</responseHeaders>
              <requestHeaders>false</requestHeaders>
              <responseDataOnError>false</responseDataOnError>
              <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
              <bytes>true</bytes>
              <sentBytes>true</sentBytes>
              <url>true</url>
              <threadCounts>true</threadCounts>
              <idleTime>true</idleTime>
              <connectTime>true</connectTime>
            </value>
          </objProp>
          <stringProp name="filename">results/aggregate.jtl</stringProp>
        </ResultCollector>
        <hashTree/>

      </hashTree><!-- end ThreadGroup hashTree -->

    </hashTree><!-- end TestPlan hashTree -->
  </hashTree><!-- end root hashTree -->
</jmeterTestPlan>
