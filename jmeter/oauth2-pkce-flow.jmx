        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="04 Simulate Auth Server (login + 2FA → issue code)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
import java.security.SecureRandom
import java.util.Base64

// Simulate the user filling credentials (${username} / ${password})
// and 2FA code (${totp_code}) on auth-server.html — no HTTP request is made.
// The auth-server page JS then generates a random auth code and redirects.
// We replicate that here so step 05 can use a realistic code value.

def random = new SecureRandom()
def codeBytes = new byte[16]
random.nextBytes(codeBytes)
def authCode = Base64.getUrlEncoder().withoutPadding().encodeToString(codeBytes)
vars.put(&quot;auth_code&quot;, authCode)

// Simulate user think time: credential entry + TOTP + button clicks
long thinkMs = ${USER_THINK_CONSTANT_MS} + (long)(Math.random() * ${USER_THINK_RANGE_MS})
Thread.sleep(thinkMs)

log.info(&quot;Auth simulated — user=${vars.get(&apos;username&apos;)} auth_code_prefix=${authCode.take(8)}... think=${thinkMs}ms&quot;)
          </stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
